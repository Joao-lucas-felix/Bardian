<%# Desenha a pauta e as notas decorativas; não recebe locals.
    Os valores configuram apenas a ilustração, sem representar eventos de áudio. %>
<svg class="story-music" viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice"
     aria-hidden="true" focusable="false">
  <g class="music-staff" fill="none" stroke="currentColor" stroke-width="1">
    <%# Desenha as cinco linhas da pauta decorativa.
        Cada linha repete a curva com deslocamento vertical de 18 unidades. %>
    <% 5.times do |line_index| %>
      <% offset = line_index * 18 %>
      <path
        d="M -100 <%= 620 + offset %>
           C 400 <%= 380 + offset %>
             930 <%= 800 + offset %>
             1500 <%= 410 + offset %>"
      />
    <% end %>
  </g>
  <%# A posição-base define a composição; o movimento varia em duração e direção. %>
  <% [[120, 220, 23, -8, 38, -45, 1.3], [1130, 240, 31, -17, -42, 34, 1.8], [990, 620, 27, -5, 52, -65, 1.1], [300, 720, 37, -24, -28, -48, 0.9], [1280, 770, 29, -12, -60, 20, 1.5], [740, 130, 41, -30, 30, 46, 0.8], [640, 760, 33, -10, 45, -32, 1.2]].each do |x, y, duration, delay, dx, dy, scale| %>
    <g transform="translate(<%= x %> <%= y %>) scale(<%= scale %>)">
      <g class="ambient-note" style="--duration: <%= duration %>s; --delay: <%= delay %>s; --drift-x: <%= dx %>px; --drift-y: <%= dy %>px">
        <ellipse cx="0" cy="0" rx="13" ry="9" transform="rotate(-20)" />
        <path d="M 12 0 v -55 Q 38 -47 24 -26" fill="none" stroke="currentColor" stroke-width="2.5" />
      </g>
    </g>
  <% end %>
</svg>
