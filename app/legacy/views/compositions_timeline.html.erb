<%# Recebe contagens do controller; faixas e regiões são desenhadas do documento JSON. %>
<section class="composition-timeline" aria-labelledby="composition-timeline-title">
  <div class="composition-timeline-heading">
    <div>
      <h2 id="composition-timeline-title">Timeline</h2>
      <p data-composition-timeline-target="summary"><%= pluralize(track_count, "faixa") %> · <%= pluralize(region_count, "região", "regiões") %> · <%= pluralize(note_count, "nota") %></p>
    </div>
    <div class="composition-timeline-actions">
      <%# A ajuda permanece disponível sem subtrair altura da área de faixas. %>
      <details class="composition-editor-guide">
        <summary>Ajuda</summary>
        <p class="composition-timeline-help">Arraste uma região para mover; arraste sua borda direita para mudar a duração. Com a região selecionada, use ← e → para mover, Shift + setas para redimensionar e Delete para excluir.</p>
      </details>
      <button type="button" class="product-button product-button-secondary" data-action="click->composition-timeline#addTrack">Adicionar faixa</button>
      <div class="composition-timeline-zoom" aria-label="Zoom da timeline">
        <button type="button" data-action="click->composition-timeline#zoomOut" aria-label="Diminuir zoom">−</button>
        <span data-composition-timeline-target="zoomLabel">100%</span>
        <button type="button" data-action="click->composition-timeline#zoomIn" aria-label="Aumentar zoom">+</button>
      </div>
    </div>
  </div>
  <%# Controles globais operam no documento em memória; os campos de loop persistem pelo salvamento normal. %>
  <div class="composition-transport" aria-label="Reprodução da composição">
    <div class="composition-transport-buttons">
      <button type="button" class="product-button composition-transport-primary" data-composition-timeline-target="playToggle" data-action="click->composition-timeline#toggleCompositionPlayback" aria-label="Tocar composição">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M8 5.2v13.6a1 1 0 0 0 1.5.86l10.2-6.8a1 1 0 0 0 0-1.72L9.5 4.34A1 1 0 0 0 8 5.2Z" fill="currentColor" /></svg>
        <span data-composition-timeline-target="playToggleLabel">Tocar</span>
      </button>
      <button type="button" class="product-button product-button-secondary" data-composition-timeline-target="loopButton" data-action="click->composition-timeline#toggleCompositionLoop" aria-pressed="true">Alternar loop</button>
    </div>
    <div class="composition-loop-fields" aria-label="Marcadores de loop em ticks">
      <label>Início <input type="number" min="0" step="1" data-composition-timeline-target="loopStart" data-action="change->composition-timeline#changeLoopMarker"></label>
      <label>Fim <input type="number" min="1" step="1" data-composition-timeline-target="loopEnd" data-action="change->composition-timeline#changeLoopMarker"></label>
    </div>
    <span class="composition-transport-status" data-composition-timeline-target="transportStatus" role="status" aria-live="polite">Parado</span>
  </div>
  <div class="composition-timeline-scroll" data-composition-timeline-target="scroll">
    <div class="composition-timeline-ruler" data-composition-timeline-target="ruler" aria-label="Régua de compassos">
      <div class="composition-playhead" data-composition-timeline-target="playhead" aria-hidden="true"></div>
      <button type="button" class="composition-loop-handle composition-loop-start" data-composition-timeline-target="loopStartHandle" data-marker="start" data-action="pointerdown->composition-timeline#startLoopMarkerDrag keydown->composition-timeline#loopMarkerKey" aria-label="Início do loop; arraste ou use as setas" tabindex="0"></button>
      <button type="button" class="composition-loop-handle composition-loop-end" data-composition-timeline-target="loopEndHandle" data-marker="end" data-action="pointerdown->composition-timeline#startLoopMarkerDrag keydown->composition-timeline#loopMarkerKey" aria-label="Fim do loop; arraste ou use as setas" tabindex="0"></button>
    </div>
    <div data-composition-timeline-target="tracks"></div>
  </div>
  <p class="composition-timeline-empty" data-composition-timeline-target="empty">Adicione uma faixa para começar sua composição.</p>
</section>
