<%# Exibe as ações de conta disponíveis para o perfil autenticado ou visitante. %>
<nav class="account-nav" aria-label="Conta">
  <% if user_signed_in? %>
    <%= link_to "Dashboard", dashboard_path if current_user.admin? %>
    <%= button_to "Sair", destroy_user_session_path, method: :delete %>
  <% else %>
    <%= link_to "Entrar", new_user_session_path %>
    <%= link_to "Criar conta", new_user_registration_path %>
  <% end %>
</nav>
