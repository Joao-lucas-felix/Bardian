<%# Formulário público de cadastro; o perfil nunca é escolhido pelo visitante. %>
<% content_for :title, "Criar conta — Bardian" %>
<% content_for :main_class, "auth-page" %>

<section class="auth-card" aria-labelledby="auth-title">
  <p class="auth-kicker">Bardian</p>
  <h1 id="auth-title">Criar conta</h1>
  <p class="auth-description">Comece a explorar seu espaço musical.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :email, "E-mail" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="auth-field">
      <%= f.label :password, "Senha" %>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <small>Use entre 6 e 128 caracteres.</small>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, "Confirmar senha" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <%= f.submit "Criar conta", class: "auth-submit" %>
  <% end %>

  <p class="auth-secondary-action">
    Já possui uma conta?
    <%= link_to "Entrar", new_session_path(resource_name) %>
  </p>
  <%# Oferece caminhos de retorno sem depender do histórico do navegador. %>
  <nav class="auth-return" aria-label="Explorar o Bardian">
    <%= link_to "Início", root_path %>
    <%= link_to "Apresentação", presentation_path %>
  </nav>
</section>
