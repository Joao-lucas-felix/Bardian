<%# Formulário de entrada comum para usuários e administradores. %>
<% content_for :title, "Entrar — Bardian" %>
<% content_for :main_class, "auth-page" %>

<section class="auth-card" aria-labelledby="auth-title">
  <p class="auth-kicker">Bardian</p>
  <h1 id="auth-title">Entrar</h1>
  <p class="auth-description">Acesse seu espaço musical.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <div class="auth-field">
      <%= f.label :email, "E-mail" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="auth-field">
      <%= f.label :password, "Senha" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <%= f.submit "Entrar", class: "auth-submit" %>
  <% end %>

  <p class="auth-secondary-action">
    Ainda não possui uma conta?
    <%= link_to "Criar conta", new_registration_path(resource_name) %>
  </p>
</section>
