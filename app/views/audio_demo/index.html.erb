<%# Demonstração mínima para validar carregamento e reprodução do piano. %>
<div data-controller="audio-demo">
  <button
    id="play-note"
    type="button"
    disabled
    data-audio-demo-target="button"
    data-action="click->audio-demo#play"
    class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded disabled:opacity-50">
    Tocar Lá
  </button>

  <p data-audio-demo-target="status" role="status">
    Carregando piano…
  </p>
</div>
